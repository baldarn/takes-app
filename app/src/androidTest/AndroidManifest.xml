<?xml version="1.0" encoding="utf-8"?>
<!--
    The pixel tests of the transition shader run under an instrumentation of their own, which needs
    nothing the build does not already have (no test runner library):

        adb shell am instrument -w app.takes.dev.test/app.takes.pixels.TransitionPixelRunner

    The target is the development build, the only one a test build is made for.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <instrumentation
        android:name="app.takes.pixels.TransitionPixelRunner"
        android:label="Transition shader pixel tests"
        android:targetPackage="app.takes.dev" />
    <!-- The sound gate of the audio engine: adb shell am instrument -w app.takes.dev.test/app.takes.sound.SoundGateRunner -->
    <instrumentation
        android:name="app.takes.sound.SoundGateRunner"
        android:label="Sound gate of the audio engine"
        android:targetPackage="app.takes.dev" />
    <!-- Exports of the time effects with every frame's time checked: adb shell am instrument -w app.takes.dev.test/app.takes.pixels.TimeExportRunner -->
    <instrumentation
        android:name="app.takes.pixels.TimeExportRunner"
        android:label="Exports of the time effects"
        android:targetPackage="app.takes.dev" />
    <!-- The person-mask analysis on a recording, timed: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.PersonMaskRunner -->
    <instrumentation
        android:name="app.takes.effects.PersonMaskRunner"
        android:label="Person-mask analysis"
        android:targetPackage="app.takes.dev" />
    <!-- The subject a camera move follows, analysed on a recording and timed: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.SubjectTrackRunner -->
    <instrumentation
        android:name="app.takes.effects.SubjectTrackRunner"
        android:label="Subject tracks"
        android:targetPackage="app.takes.dev" />
    <!-- Exports of a recording with the temporal matte, timed: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.TemporalExportRunner -->
    <instrumentation
        android:name="app.takes.effects.TemporalExportRunner"
        android:label="Temporal matte exports"
        android:targetPackage="app.takes.dev" />
    <!-- Exports of an HDR recording, with a transition, a title and a look: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.HdrExportRunner -->
    <instrumentation
        android:name="app.takes.effects.HdrExportRunner"
        android:label="HDR exports"
        android:targetPackage="app.takes.dev" />
    <!-- A whole export of a project made of one recording, timed: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.ProjectExportRunner -->
    <instrumentation
        android:name="app.takes.effects.ProjectExportRunner"
        android:label="Project exports"
        android:targetPackage="app.takes.dev" />
    <!-- DeepFilterNet3 on a recording, timed, beside sherpa-onnx: adb shell am instrument -w -e clip <path> app.takes.dev.test/app.takes.sound.DeepFilterRunner -->
    <instrumentation
        android:name="app.takes.sound.DeepFilterRunner"
        android:label="DeepFilterNet3 on a recording"
        android:targetPackage="app.takes.dev" />
    <!-- An export in sections against one pass, phase by phase: adb shell am instrument -w -e case plain app.takes.dev.test/app.takes.effects.ExportSectionsRunner -->
    <instrumentation
        android:name="app.takes.effects.ExportSectionsRunner"
        android:label="Export sections timing"
        android:targetPackage="app.takes.dev" />
    <!-- A sound file read from places partway into it: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.sound.DecodedSourceRunner -->
    <instrumentation
        android:name="app.takes.sound.DecodedSourceRunner"
        android:label="Sound files read from partway"
        android:targetPackage="app.takes.dev" />
    <!-- An export of a sound item cut partway into its file: adb shell am instrument -w -e clip <name> -e music <name> -e case split app.takes.dev.test/app.takes.sound.SoundItemExportRunner -->
    <instrumentation
        android:name="app.takes.sound.SoundItemExportRunner"
        android:label="Sound items cut partway, exported"
        android:targetPackage="app.takes.dev" />
    <!-- Stabilisation of a recording, measured, planned and exported: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.StabilizationRunner -->
    <instrumentation
        android:name="app.takes.effects.StabilizationRunner"
        android:label="Stabilisation"
        android:targetPackage="app.takes.dev" />
    <!-- Night fix in each mode on a recording, exported and timed: adb shell am instrument -w -e clip <name> app.takes.dev.test/app.takes.effects.NightFixExportRunner -->
    <instrumentation
        android:name="app.takes.effects.NightFixExportRunner"
        android:label="Night fix exports"
        android:targetPackage="app.takes.dev" />
</manifest>
